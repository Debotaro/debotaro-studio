# Core runs locally with no paid services. Node24 reads this only when copied to .env.
PORT=4173
STUDIO_DATA_DIR=.studio-data
# Loopback by default; change only for an explicitly configured hosting interface.
STUDIO_HOST=127.0.0.1
# Set an explicit allowed origin when hosting behind a proxy.
STUDIO_ORIGIN=http://localhost:4173
# Optional real model inference. ChatGPT subscription/model selection supplies no API key.
OPENAI_API_KEY=
OPENAI_MODEL=
# Demo capacity. Decimal integers only; invalid values stop startup.
# Main database pages only; WAL/temp files also need a hosting volume quota.
STUDIO_MAX_DATABASE_MB=256
STUDIO_MAX_PROJECTS=1000
STUDIO_MAX_PROJECTS_PER_OWNER=20
STUDIO_MAX_VERSIONS=100
# Includes undo, restore and accepted AI changes. Existing work is never pruned.
STUDIO_MAX_HISTORY=10000
STUDIO_MAX_CONNECTIONS=100
STUDIO_MAX_CONNECTIONS_PER_USER=5
# UTC-day provider attempts; failed/cancelled attempts count. 0 disables proposals.
# Request bounds do not replace a provider-side monetary spending limit.
STUDIO_AI_DAILY_REQUESTS=100
STUDIO_AI_USER_DAILY_REQUESTS=10
STUDIO_AI_CONCURRENT=2
