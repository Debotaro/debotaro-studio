{
  "name": "debotaro-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Debotaro's collaborative visual application builder",
  "scripts": {
    "dev": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts --production",
    "benchmark": "tsx scripts/benchmark.ts",
    "verify:export": "tsx scripts/verify-export.ts",
    "benchmark:browser": "tsx scripts/browser-benchmark.ts",
    "prepare:edge": "node scripts/prepare-edge.mjs",
    "typecheck:edge": "tsc --noEmit -p edge/tsconfig.json",
    "build:edge": "npm run prepare:edge && npm run build && node scripts/prepare-edge-assets.mjs && npm run typecheck:edge && wrangler deploy --dry-run --outdir edge-dist",
    "dev:edge": "npm run prepare:edge && wrangler dev --ip 127.0.0.1 --port 4190",
    "verify:edge": "node scripts/verify-edge.mjs",
    "test:browser:edge": "playwright test --config playwright.edge.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@babel/generator": "7.29.8",
    "@babel/parser": "7.29.9",
    "@babel/types": "7.29.8",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "express": "5.3.0",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "lucide-react": "1.57.0",
    "openai": "7.33.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/babel__generator": "7.27.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "miniflare": "4.20260730.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.151.1"
  }
}
